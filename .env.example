APP_NAME=VoxAssist AI
APP_ENV=development
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
SECRET_KEY=replace-with-a-long-random-secret
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=voxassist_kb
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_TOP_K=4
RAG_SCORE_THRESHOLD=0.20
DATABASE_URL=postgresql+psycopg://voxassist:voxassist@localhost:5432/voxassist
REDIS_URL=redis://localhost:6379/0
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_SIP_TRUNK_DOMAIN=
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
ELEVENLABS_API_KEY=
RECORD_CALLS=false
TRANSCRIPT_RETENTION_DAYS=30
REQUIRE_CALL_CONSENT=true
